{
  "version": 8,
  "name": "MontQuest 8-bit",
  "metadata": {
    "montquest:theme": "8-bit / pixel",
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0b0b12" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": { "fill-color": "#2858e8", "fill-opacity": 0.95 }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "layout": { "line-cap": "butt" },
      "paint": {
        "line-color": "#2858e8",
        "line-width": { "stops": [[8, 1.5], [16, 4]] }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "pedestrian", "track"], true, false],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-opacity": 0.28,
        "line-width": { "stops": [[10, 1.5], [16, 4], [20, 8]] }
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-width": { "stops": [[7, 1.5], [12, 3], [16, 5.5], [20, 10]] }
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8d838",
        "line-width": { "stops": [[5, 1.5], [10, 3.5], [14, 6], [20, 12]] }
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#e8283c",
        "line-width": { "stops": [[4, 1.5], [10, 3]] },
        "line-dasharray": [4, 2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.18,
        "text-size": { "stops": [[4, 11], [10, 17], [16, 22]] },
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#f8f8f8",
        "text-halo-color": "#0b0b12",
        "text-halo-width": 2
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["match", ["get", "class"], ["town", "village", "hamlet"], true, false],
      "minzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-size": { "stops": [[8, 9], [14, 13], [18, 16]] },
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#f8f8f8",
        "text-halo-color": "#0b0b12",
        "text-halo-width": 1.5
      }
    }
  ]
}
