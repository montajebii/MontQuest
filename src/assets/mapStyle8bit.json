{
  "version": 8,
  "name": "MontQuest 8-bit",
  "metadata": {
    "montquest:theme": "8-bit / pixel (Pokémon/GBA overworld, patterned)",
    "openmaptiles:version": "3.x"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f8f4e8" }
    },
    {
      "id": "landcover-solid-low",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "wood", "farmland", "ice"], true, false],
      "maxzoom": 10,
      "paint": { "fill-color": "#2fbf3f", "fill-opacity": 0.9 }
    },
    {
      "id": "landcover-pattern",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "wood", "farmland", "ice"], true, false],
      "minzoom": 10,
      "maxzoom": 16,
      "paint": { "fill-pattern": "tex-grass" }
    },
    {
      "id": "landcover-solid-high",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["grass", "wood", "farmland", "ice"], true, false],
      "minzoom": 16,
      "paint": { "fill-color": "#2fbf3f", "fill-opacity": 0.9 }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["match", ["get", "class"], ["park", "cemetery", "pitch"], true, false],
      "paint": { "fill-color": "#2fbf3f", "fill-opacity": 0.9 }
    },
    {
      "id": "water-solid-low",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "maxzoom": 10,
      "paint": { "fill-color": "#2858e8" }
    },
    {
      "id": "water-pattern",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "minzoom": 10,
      "maxzoom": 16,
      "paint": { "fill-pattern": "tex-water" }
    },
    {
      "id": "water-solid-high",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "minzoom": 16,
      "paint": { "fill-color": "#2858e8" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 8,
      "layout": { "line-cap": "butt" },
      "paint": {
        "line-color": "#2858e8",
        "line-width": { "stops": [[8, 1.5], [16, 4]] }
      }
    },
    {
      "id": "building-outline",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": { "fill-color": "#0b0b12", "fill-opacity": 0.9 }
    },
    {
      "id": "building-extrusion",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#c9c2ac",
        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          0,
          15,
          ["coalesce", ["get", "render_height"], 8]
        ],
        "fill-extrusion-base": 0,
        "fill-extrusion-vertical-gradient": false,
        "fill-extrusion-opacity": 1
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary"], true, false],
      "minzoom": 8,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#cfc9b8",
        "line-width": { "stops": [[7, 2.5], [12, 4.5], [16, 7.5], [20, 13]] }
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "pedestrian", "track"], true, false],
      "minzoom": 8,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#e0dccc",
        "line-width": { "stops": [[10, 1.5], [16, 4], [20, 8]] }
      }
    },
    {
      "id": "road-secondary-solid-low",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "minzoom": 8,
      "maxzoom": 14,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-width": { "stops": [[7, 1.5], [12, 3]] }
      }
    },
    {
      "id": "road-secondary-pattern",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "minzoom": 14,
      "maxzoom": 19,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-pattern": "tex-road",
        "line-width": { "stops": [[14, 4], [16, 5.5], [19, 8]] }
      }
    },
    {
      "id": "road-secondary-solid-high",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary"], true, false],
      "minzoom": 19,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-width": { "stops": [[19, 8], [20, 10]] }
      }
    },
    {
      "id": "road-major-solid-low",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "minzoom": 5,
      "maxzoom": 14,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-width": { "stops": [[5, 1.5], [10, 3.5], [14, 6]] }
      }
    },
    {
      "id": "road-major-pattern",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "minzoom": 14,
      "maxzoom": 19,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-pattern": "tex-road",
        "line-width": { "stops": [[14, 6], [16, 8], [19, 10]] }
      }
    },
    {
      "id": "road-major-solid-high",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk"], true, false],
      "minzoom": 19,
      "layout": { "line-cap": "butt", "line-join": "miter" },
      "paint": {
        "line-color": "#f8f8f8",
        "line-width": { "stops": [[19, 10], [20, 12]] }
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 2],
      "paint": {
        "line-color": "#e8283c",
        "line-width": { "stops": [[4, 1.5], [10, 3]] },
        "line-dasharray": [4, 2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "label-street",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08,
        "text-size": { "stops": [[13, 9], [16, 12], [19, 14]] }
      },
      "paint": {
        "text-color": "#f8f8f8",
        "text-halo-color": "#0b0b12",
        "text-halo-width": 2
      }
    },
    {
      "id": "label-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.18,
        "text-size": { "stops": [[4, 11], [10, 17], [16, 22]] },
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#0b0b12",
        "text-halo-color": "#f8f8f8",
        "text-halo-width": 2
      }
    },
    {
      "id": "label-town",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["match", ["get", "class"], ["town", "village", "hamlet"], true, false],
      "minzoom": 8,
      "layout": {
        "text-field": ["coalesce", ["get", "name:fa"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15,
        "text-size": { "stops": [[8, 9], [14, 13], [18, 16]] },
        "text-anchor": "center",
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#0b0b12",
        "text-halo-color": "#f8f8f8",
        "text-halo-width": 1.5
      }
    }
  ]
}
